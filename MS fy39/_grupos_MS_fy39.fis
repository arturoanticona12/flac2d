; _grupos_MS_fy39.fis -- regiones FY39 (39 poligonos) generadas por geo_fy39.py
; asigna Material / Construction / Block(=Borde_elastico) [/ Excavacion / Relleno] por centroide de zona
fish define pip(x, y, px, py)
    local dentro = false
    local n = list.size(px)
    local j = n
    loop local i (1, n)
        local yi = py(i)
        local yj = py(j)
        if (yi > y) # (yj > y) then
            local xcr = px(i) + (y - yi) * (px(j) - px(i)) / (yj - yi)
            if x < xcr then
                dentro = not dentro
            end_if
        end_if
        j = i
    end_loop
    return dentro
end
