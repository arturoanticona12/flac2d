                                       group 'Construction=relleno_comun_2' ...
                                       group 'Construction=relave_2'
; MC - UBCHYST
zone cmodel assign mohr-coulomb range group 'Construction=relave_2'
zone cmodel assign ubc-hyst range union group 'Construction=enrocado_2' ...
                                        group 'Construction=relleno_comun_2'
; SOLVE MODEL
[assign_props(::zone.list)]
;[ini_disp_vel("relave_2")]
model solve
[Ini_K0(::zone.list)]
[Ini_Kalpha(::zone.list)]
; SAVE STAGE
