model history name='time' dynamic time-total
;
fish define put_his_disp(_x0,_y0,name)
    local id=zone.id(zone.near(_x0 ,_y0))
    command
        zone history name [name + '_disp_x'] displacement-x zoneid [id]
        zone history name [name + '_disp_y'] displacement-y zoneid [id]
    end_command
end
;
fish define put_his_acc(_x0,_y0,name)
    local id=zone.id(zone.near(_x0 ,_y0))
    command
        zone history name [name + '_acc_x'] acceleration-x zoneid [id]
    end_command
end
;
fish define calc_sigma3(id_zone)
    local z = zone.find(id_zone)
    ; Calcula el Esfuerzo Principal Menor (Sigma 3) usando Mohr
    ; Formula: Center - Radius
    local sxx_ = zone.stress.xx(z)
    local syy_ = zone.stress.yy(z)
    local sxy_ = zone.stress.xy(z)
    local center = 0.5*(sxx_ + syy_)
    local radius = math.sqrt(0.25 * (sxx_ - syy_)^2 + sxy_^2)
    local sigma3_ = center - radius
    return sigma3_
end
;
fish define calc_sstrain_eng(id_zone)
    local z = zone.find(id_zone)
    local sstrain_eng = 0.0 ; Inicializar strain acumulado en 0
    ;
    if z # null
        sstrain_eng = sstrain_eng + (2.0 * zone.strain.inc.xy(z))
    endif
    ;
    return sstrain_eng
end
;
fish define put_his_ss(_x0, _y0, _name)
    local zid = zone.id(zone.near(_x0, _y0))
    ;
    command
        zone history name [_name + '_sstress'] stress-xy zoneid [zid]
        zone history name [_name + '_pp'] pore-pressure zoneid [zid]
        fish history name [_name + '_s3'] @calc_sigma3([zid])
        fish history name [_name + '_sstrain'] @calc_sstrain_eng([zid])
    end_command
    ;
end
;
fish define calc_csr(id_zone)
    local zid = zone.find(id_zone)
    local _sv0 = -zone.stress.effective.yy(zid)
    local _sxy = zone.stress.effective.xy(zid)
    ;
    local _csr = _sxy/_sv0
    ;
    return _csr
end
;
fish define calc_ru(id_zone)
    local zid = zone.find(id_zone)
    local _sv0 = -1*zone.stress.effective.yy(zid)
    local ini_pp = zone.extra(zid,2)
    local _pp  = zone.pp(zid)
    local _pp_dif = math.abs(_pp-ini_pp)
    local _ru = _pp_dif/_sv0
    ;
    return _ru
end
;
fish define put_his_csr(_x0, _y0, _name)
    local zid = zone.id(zone.near(_x0, _y0))
    ;
    command
        fish history name [_name + '_ru'] @calc_ru([zid])
        fish history name [_name + '_csr'] @calc_csr([zid])
    end_command
    ;
end
