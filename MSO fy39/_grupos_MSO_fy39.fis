fish define buscar_region(x, y)
    ; indice de la region que contiene (x,y); 0 si ninguna; -1 si mas de una
    local hallada = 0
    local n = 0
    loop local r (1, reg_n)
        local bb = list.at(reg_bb, r)
        if x >= bb(1) then
            if x <= bb(3) then
                if y >= bb(2) then
                    if y <= bb(4) then
                        if pip(x, y, list.at(reg_px, r), list.at(reg_py, r)) then
                            hallada = r
                            n = n + 1
                        end_if
                    end_if
                end_if
            end_if
        end_if
    end_loop
    if n > 1 then
        return -1
    end_if
    return hallada
end
fish define asignar_grupos
    definir_regiones
    local n_sin = 0
    local n_dob = 0
    local n_resp = 0
    loop foreach local z zone.list
        local x = zone.pos.x(z)
        local y = zone.pos.y(z)
        local r = buscar_region(x, y)
        if r == 0 then
            ; respaldo: zona degenerada cuyo centroide cae sobre un borde -> probar a +-5 cm
            n_resp = n_resp + 1
            r = buscar_region(x + 0.05, y)
            if r <= 0 then
                r = buscar_region(x - 0.05, y)
            end_if
            if r <= 0 then
                r = buscar_region(x, y + 0.05)
            end_if
            if r <= 0 then
                r = buscar_region(x, y - 0.05)
            end_if
            io.out('GRUPOS respaldo zona ' + string(zone.id(z)) + ' en (' + string(x) + ',' + string(y) + ') -> region ' + string(r))
        end_if
        if r > 0 then
            zone.group(z, 'Material') = list.at(reg_mat, r)
            zone.group(z, 'Construction') = list.at(reg_con, r)
            if list.at(reg_brd, r) == 1 then
                zone.group(z, 'Block') = 'Borde_elastico'
            end_if
            if string.len(list.at(reg_rel, r)) > 0 then
                zone.group(z, 'Relleno') = list.at(reg_rel, r)
            end_if
            if string.len(list.at(reg_exc, r)) > 0 then
                zone.group(z, 'Excavacion') = list.at(reg_exc, r)
            end_if
        end_if
        if r == 0 then
            n_sin = n_sin + 1
        end_if
        if r < 0 then
            n_dob = n_dob + 1
        end_if
    end_loop
    io.out('GRUPOS zonas sin region=' + string(n_sin) + ' en dos regiones=' + string(n_dob) + ' resueltas por respaldo=' + string(n_resp))
    if n_sin + n_dob > 0 then
        system.error = 'asignar_grupos: zonas sin region o duplicadas'
    end_if
end
