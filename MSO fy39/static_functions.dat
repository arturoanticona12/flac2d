program call 'fishtank_props' suppress
[global Young_static_zp]
[global Young_dyn_zp]
[global Poisson_zp]
[global Shear_mod_estatic]
[global Shear_mod_dyn]
[global Bulk_mod_static]
[global Bulk_mod_dyn]
[global Density_zp]
[global Fric_zp]
[global Coh_zp]
[global Fric_zp_dyn]
[global Coh_zp_dyn]

;	RELAVES
fish define Props_Tailings(ZP)
    ;	DEFINICION DE VARIABLES 
    local Patm = 101325.0 
    local sye = sigma_v_effective(ZP)
    local P_eff = math.abs(P_effective(ZP))
    ;local e_ = 2.26*(P_eff/1000.0)^(-0.19)
    ;Density_zp = 2650/(1+e_)
	;	RESISTENCIA CORTANTE
    Density_zp = 13.5*1000.0/9.81
    Fric_zp =  30.0
    Coh_zp = 0.0
    Fric_zp_dyn = 0.0
    Coh_zp_dyn = math.max(1e3,0.05*sye)
    ;Fric_zp_dyn = 28.0
    ;Coh_zp_dyn = 0.0
	;	ELASTICIDAD (ESTATICO)
    Poisson_zp = 0.33
    local shear_velocity = math.min(300,28.6*((P_eff/1000.0)^0.35))
    Shear_mod_estatic = 12*Patm*((P_eff/Patm)^0.9)
    ;Shear_mod_estatic = Density_zp*(shear_velocity^2)
    Young_static_zp = Shear_mod_estatic*2*(1+Poisson_zp)
    Bulk_mod_static = 2*Shear_mod_estatic*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
	;	ELASTICIDAD (DINAMICO)
    Shear_mod_dyn = Density_zp*(shear_velocity^2)
    ;Shear_mod_dyn = 399*Patm*((P_eff/Patm)^0.71)
    ;Shear_mod_dyn = 30*Coh_zp_dyn
    Young_dyn_zp = Shear_mod_dyn*2*(1+Poisson_zp)
    Bulk_mod_dyn = 2*Shear_mod_dyn*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
    ;	CHECK
    zone.extra(ZP,15) = Shear_mod_estatic
    zone.extra(ZP,16) = Shear_mod_dyn
    if Shear_mod_estatic > 0
        zone.extra(ZP,17) = Shear_mod_dyn/Shear_mod_estatic
        zone.extra(ZP,18) = shear_velocity
    else
        zone.extra(ZP,17) = 0
        zone.extra(ZP,18) = 0
    end_if
end
;
;	ARCILLA
fish define Props_Clay(ZP)
    ;	DEFINICION DE VARIABLES
    local Patm = 101325.0
    local sye = sigma_v_effective(ZP)
	;	RESISTENCIA CORTANTE
    Density_zp = 16.5*1000.0/9.81
    Fric_zp =  18.0
    Coh_zp = 0.0
    Fric_zp_dyn = 0.0
    Coh_zp_dyn = math.max(2.64e3,0.16*sye)
	;	ELASTICIDAD (ESTATICO)
    Poisson_zp = 0.39
    local shear_velocity = 120.0
    Shear_mod_estatic = Density_zp*(shear_velocity^2)/10.0
    Young_static_zp = Shear_mod_estatic*2*(1+Poisson_zp)
    Bulk_mod_static = 2*Shear_mod_estatic*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
	;	ELASTICIDAD (DINAMICO)
    Shear_mod_dyn = Density_zp*(shear_velocity^2)
    Young_dyn_zp = Shear_mod_dyn*2*(1+Poisson_zp)
    Bulk_mod_dyn = 2*Shear_mod_dyn*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
    ;	CHECK
    zone.extra(ZP,15) = Shear_mod_estatic
    zone.extra(ZP,16) = Shear_mod_dyn
    if Shear_mod_estatic > 0
        zone.extra(ZP,17) = Shear_mod_dyn/Shear_mod_estatic
        zone.extra(ZP,18) = shear_velocity
    else
        zone.extra(ZP,17) = 0
        zone.extra(ZP,18) = 0
    end_if
end 

fish define Props_Dique(ZP)
    ;; Parametros resitentes
    local pp =  zone.pp(ZP)
    local S3 = math.abs(sigma_3_total(ZP))
    local S3e = math.abs(sigma_3_effective(ZP))               
                                                ; pensar que ocurre cuando se rotan los espfuerzos y S3 cambia al lado izquiedo del MC
    Density_zp = 18.5*1000.0/9.81
    Fric_zp =  47
    Coh_zp = 6*1000   ;valore residual
    Fric_zp_dyn = Fric_zp
    Coh_zp_dyn = Coh_zp
    ;; Parametros elasticos
    local P_eff = math.abs(P_effective(ZP))       ; pensar que ocurre cuando se rotan los espfuerzos y S3 cambia al lado izquiedo del MC   
    Poisson_zp = 0.33
    local Patm = 101325.0                         ; referencia en pascales
    Shear_mod_estatic = 84*Patm*((P_eff/Patm)^0.4)
    Young_static_zp = Shear_mod_estatic*2*(1+Poisson_zp)
    local shear_velocity = 91.5*((P_eff/1000)^0.25)
    Shear_mod_dyn = 1773*Patm*((S3e/Patm)^0.5) 
    Young_dyn_zp = Shear_mod_dyn*2*(1+Poisson_zp)
    Bulk_mod_static = 2*Shear_mod_estatic*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
    Bulk_mod_dyn = 2*Shear_mod_dyn*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
    ;;;;; check props 
    zone.extra(ZP,15) = Shear_mod_estatic
    zone.extra(ZP,16) = Shear_mod_dyn
    if Shear_mod_estatic > 0
        zone.extra(ZP,17) = Shear_mod_dyn/Shear_mod_estatic
        zone.extra(ZP,18) = shear_velocity
    else
        zone.extra(ZP,17) = 0
        zone.extra(ZP,18) = 0
    end_if
end
;
;	DREN
fish define Props_3A(ZP) ; no se consideran los materiales 3C y 3B (fuera del analisis) 
    ;	DEFINICION DE VARIABLES
    local Patm = 101325.0
    local P_eff = math.abs(P_effective(ZP))
    ;	RESISTENCIA CORTANTE
    Density_zp = 18.0*1000.0/9.81
    Fric_zp =  38.0
    Coh_zp = 0.0
    Fric_zp_dyn = Fric_zp
    Coh_zp_dyn = 0.0
	;	ELASTICIDAD (ESTATICO)
    Poisson_zp = 0.33
    local shear_velocity = 91.5*((P_eff/1000)^0.25) 
    Shear_mod_estatic = 84*Patm*((P_eff/Patm)^0.4)
    Young_static_zp = Shear_mod_estatic*2*(1+Poisson_zp)
    Bulk_mod_static = 2*Shear_mod_estatic*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
	;	ELASTICIDAD (DINAMICO)
    Shear_mod_dyn = 1773*Patm*((P_eff/Patm)^0.5)
    Young_dyn_zp = Shear_mod_dyn*2*(1+Poisson_zp)
    Bulk_mod_dyn = 2*Shear_mod_dyn*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
	;	CHECK
    zone.extra(ZP,15) = Shear_mod_estatic
    zone.extra(ZP,16) = Shear_mod_dyn
    if Shear_mod_estatic > 0
        zone.extra(ZP,17) = Shear_mod_dyn/Shear_mod_estatic
        zone.extra(ZP,18) = shear_velocity
    else
        zone.extra(ZP,17) = 0
        zone.extra(ZP,18) = 0
    end_if
end 

fish define Props_3B_3C(ZP) ; no se concideran los materiales 3C y 3B (fuera del analisis) 
    ;	DEFINICION DE VARIABLES
    local pp =  zone.pp(ZP)
    local S3 = math.abs(sigma_3_total(ZP))          
                                                ; pensar que ocurre cuando se rotan los espfuerzos y S3 cambia al lado izquiedo del MC
    Density_zp = (18.0*int(pp==0) + 20.0*int(pp>0))*101.971621
    Fric_zp =  38.0
    Coh_zp = 0    ;valore residual
    Fric_zp_dyn = Fric_zp
    Coh_zp_dyn = Coh_zp
    ;; Parametros elasticos
    local P_eff = math.abs(P_effective(ZP))       ; pensar que ocurre cuando se rotan los espfuerzos y S3 cambia al lado izquiedo del MC   
    Poisson_zp = 0.33
    local Patm = 101325.0                         ; referencia en pascales
    Shear_mod_estatic = 84*Patm*((P_eff/Patm)^0.4)
    Young_static_zp = Shear_mod_estatic*2*(1+Poisson_zp)
    local shear_velocity = 91.5*((P_eff/1000)^0.25) 
    Shear_mod_dyn = 1773*Patm*((P_eff/Patm)^0.5) 
    Young_dyn_zp = Shear_mod_dyn*2*(1+Poisson_zp)
    Bulk_mod_static = 2*Shear_mod_estatic*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
    Bulk_mod_dyn = 2*Shear_mod_dyn*(1+Poisson_zp)/(3*(1-2*Poisson_zp))
    ;;;;; check props 
    zone.extra(ZP,15) = Shear_mod_estatic
    zone.extra(ZP,16) = Shear_mod_dyn
    if Shear_mod_estatic > 0
        zone.extra(ZP,17) = Shear_mod_dyn/Shear_mod_estatic
        zone.extra(ZP,18) = shear_velocity
    else
        zone.extra(ZP,17) = 0
        zone.extra(ZP,18) = 0
    end_if
end
;	RELLENO COMUN (1A) Y SELECCIONADO (1B)
